# Banco (Postgres). Local: o do docker-compose. Produção: o da VPS, com SSL.
DATABASE_URL=postgresql://oms:oms@localhost:5433/oms
# Banco usado pelos testes de integração (é apagado a cada teste).
TEST_DATABASE_URL=postgresql://oms:oms@localhost:5433/oms_test

# Assina o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Fuso usado em "pedidos de hoje", filtros por data e no PDF.
APP_TIMEZONE=America/Sao_Paulo

# EvolutionAPI da plataforma (URL do servidor e Global API Key). Com elas, cada
# loja conecta o WhatsApp sozinha em Configurações: o sistema cria a instância,
# mostra o QR Code e guarda a chave. Sem elas, a loja preenche os dados à mão.
# EVOLUTION_API_URL=https://evolution.suaempresa.com.br
# EVOLUTION_API_KEY=

# Opcionais
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...   (para sslmode=verify-ca ou verify-full)
# COOKIE_SECURE=false      (só se servir sem HTTPS fora da Vercel)
# TRUST_PROXY=1            (atrás de proxy reverso fora da Vercel)
# EVOLUTION_TIMEOUT_MS=30000
